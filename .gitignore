/target
# Workspace-local CARGO_HOME shim, used only when the real ~/.cargo is read-only
/.cargo/
# Fixture build artifacts and transient probe state
/tests/fixtures/*/target/
/tests/fixtures/*/Cargo.lock
*.cargo-hole.bak
.cargo-hole.probe.lock
# The `cargo hole build` shadow tree: a full copy of the crate plus its own
# target directory, regenerated on demand and never worth committing
.cargo-hole/build/
/.npm/
# Scratch crates built by hand while checking how cargo behaves
/.probe-test/
